{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "predev": "bun run preview:manifest",
    "dev": "bun --conditions=development node_modules/@react-router/dev/bin.cjs dev",
    "prebuild": "bun run preview:manifest",
    "build": "react-router build",
    "preview": "bun scripts/preview-pages.mjs",
    "prebuild:pages": "bun run preview:manifest",
    "build:pages": "react-router build && bun scripts/prepare-pages.mjs",
    "preview:manifest": "bun scripts/preview-manifest.mjs",
    "pretypecheck": "bun run preview:manifest",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@react-router/node": "8.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "isbot": "^5",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.4.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^8"
  }
}
