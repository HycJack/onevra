+//go:build windows
+
+package d3d11
+
+import (
+	"github.com/egoist/mygo/internal/gpu/gputest"
+	"runtime"
+	"testing"
+)
+
+func TestNativeCompositionGPU(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	s := gputest.NativeScene()
+	r, err := NewComposition(hiddenWindow(t, s.Width, s.Height))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Release()
+	for range 2 {
+		if err := r.draw(s); err != nil {
+			t.Fatal(err)
+		}
+		pixels, stride := r.readBack(t)
+		gputest.Compare(t, "native-d3d11", pixels, stride, s)
+		if pixels[15*stride+40*4+3] != 0 || pixels[40*stride+40*4+3] != 128 {
+			t.Fatal("GPU native/overlay alpha incorrect")
+		}
+		if err := r.present(1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if r.compDevice == 0 || r.compTarget == 0 || r.compVisual == 0 {
+		t.Fatal("not a composition swap chain")
+	}
+}
