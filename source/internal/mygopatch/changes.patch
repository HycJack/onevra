+package mygo
+
+import "github.com/egoist/mygo/internal/platform"
+
+// NativeComposition exposes borrowed platform handles for an external system
+// view compositor. View is an NSView on macOS, HWND a child HWND on Windows.
+// Handles belong to the window; use them only on the UI thread while it lives.
+type NativeComposition struct{ View, HWND uintptr }
+
+// PrepareNativeComposition enables alpha-preserving GPU presentation. It must
+// not be called while building or painting Content. Rendering stays with MyGo;
+// this does not expose a GPU device or transfer ownership to the caller.
+func (w *Window) PrepareNativeComposition() (NativeComposition, error) {
+	var result NativeComposition
+	var err error
+	onMain(func() {
+		if w.native == nil || w.conn == nil || w.conn.ResetGPU == nil {
+			err = platform.ErrUnsupported
+			return
+		}
+		s, ok := w.conn.Surface.(interface{ EnableNativeComposition() error })
+		if !ok {
+			err = platform.ErrUnsupported
+			return
+		}
+		w.conn.ResetGPU()
+		if err = s.EnableNativeComposition(); err != nil {
+			return
+		}
+		n := w.conn.Surface.Native()
+		result = NativeComposition{View: n.View, HWND: n.HWND}
+		w.contentChanged()
+	})
+	return result, err
+}
+
+// WithNativeBrowser invokes fn on the UI thread once the browser exists, or
+// with an error. The borrowed handle is WKWebView or ICoreWebView2Controller.
+// This is an experimental interop API, not permission to release the handle.
+func (p *Page) WithNativeBrowser(fn func(uintptr, error)) {
+	onMain(func() {
+		if p.w.native == nil {
+			fn(0, errDestroyed)
+			return
+		}
+		if n, ok := p.w.native.(interface{ NativeBrowser(func(uintptr, error)) }); ok {
+			n.NativeBrowser(fn)
+		} else {
+			fn(0, platform.ErrUnsupported)
+		}
+	})
+}
