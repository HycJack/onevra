+//go:build windows
+
+package d3d11
+
+import (
+	"fmt"
+	"syscall"
+	"unsafe"
+
+	"github.com/egoist/mygo/internal/gpu/d3d11/device"
+)
+
+var compositionCreate = syscall.NewLazyDLL(device.SystemDir() + `\dcomp.dll`).NewProc("DCompositionCreateDevice")
+var iidComposition = guid{0xc37ea93a, 0xe7aa, 0x450d, [8]byte{0xb1, 0x6f, 0x97, 0x46, 0xcb, 0x04, 0x07, 0xf3}}
+
+// NewComposition presents the same GPU scene through an alpha-preserving
+// DirectComposition visual, rather than an opaque HWND swap chain.
+func NewComposition(hwnd uintptr) (*Renderer, error) {
+	r, err := New(hwnd)
+	if err != nil {
+		return nil, err
+	}
+	r.composition = true
+	return r, nil
+}
+
+func (r *Renderer) composeSwapChain(desc *swapChainDesc1) error {
+	desc.AlphaMode = 1  // DXGI_ALPHA_MODE_PREMULTIPLIED
+	desc.SwapEffect = 3 // FLIP_SEQUENTIAL, required by CreateSwapChainForComposition
+	hr := call(r.factory, 24, r.device, uintptr(unsafe.Pointer(desc)), 0, uintptr(unsafe.Pointer(&r.swapChain)))
+	if failed(hr) {
+		return fmt.Errorf("d3d11: composition swap chain: %#x", uint32(hr))
+	}
+	var dxgi uintptr
+	hr = call(r.device, 0, uintptr(unsafe.Pointer(&iidIDXGIDevice)), uintptr(unsafe.Pointer(&dxgi)))
+	if failed(hr) {
+		return fmt.Errorf("d3d11: DXGI device: %#x", uint32(hr))
+	}
+	defer free(&dxgi)
+	hr, _, _ = compositionCreate.Call(dxgi, uintptr(unsafe.Pointer(&iidComposition)), uintptr(unsafe.Pointer(&r.compDevice)))
+	if failed(hr) {
+		return fmt.Errorf("d3d11: composition device: %#x", uint32(hr))
+	}
+	for _, step := range []struct {
+		obj    uintptr
+		method int
+		args   []uintptr
+	}{
+		{r.compDevice, 6, []uintptr{r.hwnd, 1, uintptr(unsafe.Pointer(&r.compTarget))}},
+		{r.compDevice, 7, []uintptr{uintptr(unsafe.Pointer(&r.compVisual))}},
+	} {
+		if hr = call(step.obj, step.method, step.args...); failed(hr) {
+			return fmt.Errorf("d3d11: composition target/visual: %#x", uint32(hr))
+		}
+	}
+	if hr = call(r.compVisual, 15, r.swapChain); failed(hr) {
+		return fmt.Errorf("d3d11: visual content: %#x", uint32(hr))
+	}
+	if hr = call(r.compTarget, 3, r.compVisual); failed(hr) {
+		return fmt.Errorf("d3d11: visual root: %#x", uint32(hr))
+	}
+	if hr = call(r.compDevice, 3); failed(hr) {
+		return fmt.Errorf("d3d11: composition commit: %#x", uint32(hr))
+	}
+	return nil
+}
