+package ui
+
+import "testing"
+
+func TestNativeSlotsPreferGPU(t *testing.T) {
+	g := &pixelGPU{}
+	h, s, frame := gpuHost(t, func() (gpuRenderer, error) { return g, nil })
+	var slot NativeSlot
+	h.rt = newRuntime(func(c *Context) { slot.View(c, true).Fill() }, h)
+	frame()
+	frame()
+	if g.pixels != 0 || g.frames != 2 || s.pixels != 0 {
+		t.Fatalf("native frames: CPU=%d GPU=%d fallback=%d", g.pixels, g.frames, s.pixels)
+	}
+}
+
+func TestNativeSlotComposition(t *testing.T) {
+	var slot NativeSlot
+	var placement NativeLayout
+	slot.OnLayout = func(l NativeLayout) { placement = l }
+	show, overlay, modal := true, false, false
+	tt := NewTester(func(c *Context) {
+		Column(c).Fill().Background(RGB(255, 0, 0)).Children(func() {
+			Box(c).Width(100).Height(80).Clip().Children(func() {
+				if show {
+					slot.View(c, true).Key("web").Width(200).Height(160).Shrink(0)
+				}
+			})
+		})
+		if overlay {
+			Overlay(c, func() { Box(c).Absolute().Left(10).Top(10).Width(40).Height(40).Background(RGBA(0, 0, 0, .5)) })
+		}
+		if modal {
+			AlertDialog(c, &modal, "Modal", "Blocked page", "Cancel", "OK")
+		}
+		Button(c, "Native").Absolute().Left(110).Top(10).Width(80).Height(40)
+	}, 300, 240)
+	if placement.Bounds.W != 200 || placement.Clip.W != 100 || placement.Clip.H != 80 {
+		t.Fatalf("clip: %+v", placement)
+	}
+	if !slot.HitTest(5, 5, false) || slot.HitTest(120, 60, false) {
+		t.Fatal("hit escaped clip")
+	}
+	if got := tt.Image().RGBAAt(5, 5); got.A != 0 {
+		t.Fatalf("native hole: %v", got)
+	}
+	if got := tt.Image().RGBAAt(105, 75); got.A != 255 {
+		t.Fatalf("hole escaped clip: %v", got)
+	}
+	overlay = true
+	tt.Frame()
+	if slot.HitTest(20, 20, false) || !slot.HitTest(5, 5, false) {
+		t.Fatal("overlay hit order")
+	}
+	if got := tt.Image().RGBAAt(20, 20); got.A != 128 {
+		t.Fatalf("overlay alpha: %v", got)
+	}
+	tt.Press(130, 30)
+	if slot.HitTest(5, 5, false) {
+		t.Fatal("native view stole capture")
+	}
+	tt.Release(130, 30)
+	if !slot.HitTest(5, 5, true) {
+		t.Fatal("web press rejected")
+	}
+	tt.Frame()
+	if !placement.Focused {
+		t.Fatal("native logical focus lost")
+	}
+	modal = true
+	tt.Frame()
+	if slot.HitTest(5, 5, true) || placement.Focused {
+		t.Fatal("modal input/focus leaked")
+	}
+	modal = false
+	show = false
+	tt.Frame()
+	if placement.Visible || slot.HitTest(5, 5, false) {
+		t.Fatal("omission did not unmount")
+	}
+	show = true
+	tt.Frame()
+	if !placement.Visible {
+		t.Fatal("return did not remount")
+	}
+	slot.Close()
+	slot.Close()
+	tt.Frame()
+	if slot.HitTest(5, 5, false) {
+		t.Fatal("closed slot hit")
+	}
+}
