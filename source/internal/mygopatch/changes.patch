+//go:build windows && (amd64 || arm64)
+
+package windows
+
+import "errors"
+
+func (w *window) NativeBrowser(done func(uintptr, error)) {
+	w.withWebViewOr(func() { done(w.controller, nil) }, func(err error) { done(0, err) })
+}
+
+func (s *surface) EnableNativeComposition() error {
+	if s.compositionEnabled {
+		return nil
+	}
+	// NOREDIRECTIONBITMAP is a creation-time flag; an existing HWND swap
+	// chain cannot be changed into an alpha-composited surface in place.
+	h := createWindow(wsExLayered|wsExNoRedirect, surfaceClass, "", wsChild|wsClipSiblings, 0, 0, 0, 0, s.w.hwnd)
+	if h == 0 {
+		return errors.New("mygo: cannot create composition surface")
+	}
+	if ok, _, _ := procSetLayeredWindowAttributes.Call(h, 0, 255, lwaAlpha); ok == 0 {
+		procDestroyWindow.Call(h)
+		return errors.New("mygo: cannot enable composition surface input")
+	}
+	old := s.hwnd
+	procDestroyWindow.Call(old)
+	s.hwnd, s.compositionEnabled = h, true
+	s.w.b.surfaces[h] = s
+	procImmAssociateContextEx.Call(h, 0, 0)
+	s.acceptFileDrops()
+	s.fit()
+	procShowWindow.Call(h, swShow)
+	if s.w.caption != nil {
+		s.w.caption.layout()
+	}
+	return nil
+}
