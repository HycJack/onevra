+package ui
+
+import "github.com/egoist/mygo/internal/scene"
+
+// NativeLayout locates an OS-composited view in window DIPs. Clip is the
+// effective rectangular ancestor clip. Focused is logical toolkit focus.
+type NativeLayout struct {
+	Bounds, Clip     Rect
+	Visible, Focused bool
+	// Blocked changes when a modal or a disabled ancestor takes input away,
+	// even if the browser acquired OS focus independently of toolkit focus.
+	Blocked bool
+}
+
+// NativeSlot integrates a retained system view with layout, paint order, modal
+// barriers and pointer capture. It does not implement browser input. Use only
+// with a composition-enabled window. Methods and callbacks run on the UI thread.
+// OnLayout records placement during paint; defer native hierarchy changes.
+// Rounded native clips, transforms and opacity transitions are not supported.
+type NativeSlot struct {
+	OnLayout func(NativeLayout)
+	rt       *engine
+	id       uint64
+	layout   NativeLayout
+	closed   bool
+}
+
+// View builds one slot per frame. Omitting it unmounts the native view on paint.
+// Native pixels replace earlier UI backgrounds; later overlays blend over them.
+func (n *NativeSlot) View(c *Context, visible bool) *Element {
+	e := Box(c).Focusable()
+	if n.closed {
+		return e
+	}
+	if n.rt != nil && n.rt != c.rt {
+		panic("ui: NativeSlot cannot change windows")
+	}
+	n.rt = c.rt
+	if c.rt.nativeSlots == nil {
+		c.rt.nativeSlots = map[*NativeSlot]bool{}
+	}
+	c.rt.nativeSlots[n] = false
+	return e.Draw(func(p *Painter, r Rect) {
+		n.id = e.id
+		clip := intersect(r, p.clip)
+		blocked := e.IsDisabled() || (c.rt.modal != 0 && e.st.scope != c.rt.modal)
+		n.layout = NativeLayout{Bounds: r, Clip: clip, Visible: visible && clip.W > 0 && clip.H > 0, Focused: c.rt.focused == e.id && !blocked, Blocked: blocked}
+		c.rt.nativeSlots[n] = true
+		if n.layout.Visible {
+			p.s.Ops = append(p.s.Ops, scene.Op{Kind: scene.OpNative, Rect: p.snap(r)})
+		}
+	})
+}
+
+func (rt *engine) finishNativeSlots() {
+	for n, painted := range rt.nativeSlots {
+		if !painted {
+			n.layout = NativeLayout{}
+		}
+		if n.OnLayout != nil {
+			n.OnLayout(n.layout)
+		}
+	}
+}
+
+// HitTest decides routing using committed UI state, not a second hit list.
+// down observes an outside click and gives logical focus to the native slot.
+// The platform must call it once per actual press, not for synthetic hover.
+func (n *NativeSlot) HitTest(x, y float64, down bool) bool {
+	if n.closed || n.rt == nil || !n.layout.Visible || !n.layout.Clip.Contains(float32(x), float32(y)) {
+		return false
+	}
+	rt := n.rt
+	s := rt.states[n.id]
+	if s == nil || s.flags&(flagDisabled|flagInvisible|flagInert) != 0 || (rt.modal != 0 && s.scope != rt.modal) || rt.pressed != nil || rt.scrollDrag.st != nil {
+		return false
+	}
+	chain := rt.hitChain(float32(x), float32(y))
+	if len(chain) == 0 || chain[0] != n.id {
+		return false
+	}
+	if down {
+		rt.focused = n.id
+		rt.focusVisible = false
+		rt.downs = append(rt.downs, n.id)
+		rt.requestFrame()
+	}
+	return true
+}
+
+// Close forgets this slot without destroying its external view.
+func (n *NativeSlot) Close() {
+	if n.closed {
+		return
+	}
+	n.closed = true
+	if n.rt != nil {
+		delete(n.rt.nativeSlots, n)
+	}
+	n.rt = nil
+	n.layout = NativeLayout{}
+}
