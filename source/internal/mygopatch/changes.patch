+package gputest
+
+import "github.com/egoist/mygo/internal/scene"
+
+// NativeScene exercises destination-out holes between ordinary UI operations,
+// clipped at fractional boundaries, with translucent content painted above.
+func NativeScene() *scene.Scene {
+	s := &scene.Scene{Width: 100, Height: 100, Scale: 1}
+	s.Ops = []scene.Op{
+		{Kind: scene.OpFill, Rect: scene.Rect{W: 100, H: 100}, Color: scene.Color{R: 255, A: 255}},
+		{Kind: scene.OpNative, Rect: scene.Rect{X: 10, Y: 10, W: 80, H: 80}},
+		{Kind: scene.OpFill, Rect: scene.Rect{X: 20, Y: 20, W: 30, H: 30}, Color: scene.Color{B: 255, A: 128}},
+		{Kind: scene.OpPushClip, Rect: scene.Rect{X: 5.25, Y: 5.5, W: 20, H: 20}},
+		{Kind: scene.OpNative, Rect: scene.Rect{W: 100, H: 100}},
+		{Kind: scene.OpPopClip},
+		{Kind: scene.OpFill, Rect: scene.Rect{X: 60, Y: 60, W: 20, H: 20}, Color: scene.Color{G: 255, A: 255}},
+	}
+	return s
+}
