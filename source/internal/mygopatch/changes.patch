+package raster
+
+import "github.com/egoist/mygo/internal/scene"
+
+// Native holes use destination-out, as the GPU's native blend pipeline does.
+func (r *renderer) nativeHole(op *scene.Op) {
+	x0, y0, x1, y1 := r.pixelBounds(op.Rect)
+	shape := newShape(op.Rect, [4]float32{})
+	for y := y0; y < y1; y++ {
+		for x := x0; x < x1; x++ {
+			keep := 1 - coverage(&shape, float32(x)+0.5, float32(y)+0.5)*r.clipCoverage(x, y)
+			i := y*r.dst.Stride + x*4
+			for k := range 4 {
+				r.dst.Pix[i+k] = byte(float32(r.dst.Pix[i+k])*keep + 0.5)
+			}
+		}
+	}
+}
