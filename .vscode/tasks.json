{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run",
      "type": "process",
      "command": "go",
      "args": ["run", "./tools/packer", "run"],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "options": {
        "cwd": "${workspaceFolder}/source"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "build",
      "type": "process",
      "command": "go",
      "args": ["run", "./tools/packer", "build"],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "options": {
        "cwd": "${workspaceFolder}/source"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$go"
    }
  ]
}
